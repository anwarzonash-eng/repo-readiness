{
  "name": "repo-readiness",
  "version": "0.2.0",
  "description": "CLI that checks a git repository for README, LICENSE, ROADMAP, committed secrets and tracked env files",
  "type": "module",
  "bin": { "repo-readiness": "dist/cli.js" },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test \"dist/**/*.test.js\"",
    "start": "node dist/cli.js"
  },
  "keywords": ["cli", "git", "readme", "license", "secrets"],
  "author": "Zonash",
  "license": "MIT",
  "engines": { "node": ">=18" },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
